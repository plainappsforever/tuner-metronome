# Blind pitch set 1: the 404 WAVs (172 MB) and the engine outputs stay out of git (the repo keeps large data out, D38);
# truth.json, commands.tsv, scripts, MANIFEST.sha256 (checksums of the WAVs) and the report are committed.
test/blind/pitch-1/*.wav
# Fix round 2 (D37): the 13 16-bit files the regression tests use (src/engine/pitch/blind1-regression.test.ts, 3.8 MB)
!test/blind/pitch-1/038_pluck-bass_G2_phonemic_locked_48k_pcm16.wav
!test/blind/pitch-1/044_pluck-bass-lowB_B0_B8e-4_phonemic_locked_44k1_pcm16.wav
!test/blind/pitch-1/046_pluck-bass-lowB_B0_B2e-3_phonemic_locked_44k1_pcm16.wav
!test/blind/pitch-1/148_wind_tuba_D1_48k_pcm16.wav
!test/blind/pitch-1/155_synth-harmonic_D1_a_48k_pcm16.wav
!test/blind/pitch-1/292_snr10_D3clarinet_room_48k_pcm16.wav
!test/blind/pitch-1/320_hum-under_E2_50Hz_snr10_48k_pcm16.wav
!test/blind/pitch-1/323_hum-under_A1_60Hz_snr10_44k1_pcm16.wav
!test/blind/pitch-1/337_click-mixed_A3cello_wood100_44k1_pcm16.wav
